{
  "name": "@sebastienrousseau/playwright-config",
  "version": "0.0.3",
  "description": "Shareable Playwright configuration rules for cross-browser E2E testing and parallel execution.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/playwright-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/playwright-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/playwright-config/issues"
  },
  "keywords": [
    "playwright",
    "playwright-config",
    "config-preset",
    "developer-tools"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "playwright.config.js",
    "playwright-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh"
  }
}
